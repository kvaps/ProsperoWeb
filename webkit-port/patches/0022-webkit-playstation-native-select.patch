-RefPtr<WebPopupMenuProxy> PageClientImpl::createPopupMenuProxy(WebPageProxy&  pageProxy)
-{
-    notImplemented();
-    return { };
+// Native PS5 select menu bridge. WebKit retains the proxy, while the foreground
+// frontend polls it through the PlayStation C API (no JavaScript injection).
+// One visible popup across the application, as with a desktop native popup.
+class PlayStationPopupMenuProxy;
+static PlayStationPopupMenuProxy* activePlayStationPopup = nullptr;
+
+class PlayStationPopupMenuProxy final : public WebPopupMenuProxy {
+public:
+    static Ref<PlayStationPopupMenuProxy> create(WebPageProxy& page)
+    {
+        return adoptRef(*new PlayStationPopupMenuProxy(page));
+    }
+
+    ~PlayStationPopupMenuProxy() override { hidePopupMenu(); }
+
+    void showPopupMenu(const WebCore::IntRect& rect, WebCore::TextDirection, double,
+        const Vector<WebPopupItem>& items, const PlatformPopupMenuData&, int32_t selectedIndex) override
+    {
+        if (activePlayStationPopup && activePlayStationPopup != this)
+            activePlayStationPopup->hidePopupMenu();
+        m_items = items;
+        m_rect = rect;
+        m_selected = selectedIndex;
+        m_visible = true;
+        activePlayStationPopup = this;
+    }
+
+    void hidePopupMenu() override
+    {
+        m_visible = false;
+        if (activePlayStationPopup == this)
+            activePlayStationPopup = nullptr;
+    }
+
+    bool matches(WebPageProxy* page) const { return m_visible && m_page == page; }
+    const WebCore::IntRect& rect() const { return m_rect; }
+    int count() const { return static_cast<int>(m_items.size()); }
+    int selected() const { return m_selected; }
+    const WebPopupItem* item(int index) const
+    {
+        if (index < 0 || static_cast<size_t>(index) >= m_items.size())
+            return nullptr;
+        return &m_items[static_cast<size_t>(index)];
+    }
+
+    void activate(int index)
+    {
+        auto* entry = item(index);
+        if (!entry || entry->m_type != WebPopupItem::Type::Item || !entry->m_isEnabled || entry->m_isLabel)
+            return;
+        if (CheckedPtr checkedClient = client()) {
+            checkedClient->setTextFromItemForPopupMenu(this, index);
+            checkedClient->valueChangedForPopupMenu(this, index);
+        }
+        hidePopupMenu();
+    }
+
+    void cancel()
+    {
+        // WPE's menu-close callback sends the old selection, preserving it.
+        if (CheckedPtr checkedClient = client())
+            checkedClient->valueChangedForPopupMenu(this, m_selected);
+        hidePopupMenu();
+    }
+
+private:
+    explicit PlayStationPopupMenuProxy(WebPageProxy& page)
+        : WebPopupMenuProxy(page.popupMenuClient()), m_page(&page) { }
+
+    WebPageProxy* m_page = nullptr;
+    WebCore::IntRect m_rect;
+    Vector<WebPopupItem> m_items;
+    int m_selected = -1;
+    bool m_visible = false;
+};
+
+RefPtr<WebPopupMenuProxy> PageClientImpl::createPopupMenuProxy(WebPageProxy& pageProxy)
+{
+    return PlayStationPopupMenuProxy::create(pageProxy);
 }
 
