 } // namespace WebKit
+
+// Exported from this translation unit to avoid a second cross-module state
+// registry. WebKit's proxy remains the single owner of each popup.
+extern "C" bool WKPagePopupMenuInfoPlayStation(WKPageRef page, int* count,
+    int* selectedIndex, int* x, int* y, int* width, int* height)
+{
+    auto* popup = WebKit::activePlayStationPopup;
+    if (!page || !popup || !popup->matches(WebKit::toImpl(page)))
+        return false;
+    const auto& rect = popup->rect();
+    if (count) *count = popup->count();
+    if (selectedIndex) *selectedIndex = popup->selected();
+    if (x) *x = rect.x();
+    if (y) *y = rect.y();
+    if (width) *width = rect.width();
+    if (height) *height = rect.height();
+    return true;
+}
+
+extern "C" bool WKPagePopupMenuItemPlayStation(WKPageRef page, int index,
+    char* label, size_t labelBytes, bool* isSelectable)
+{
+    auto* popup = WebKit::activePlayStationPopup;
+    if (!page || !popup || !popup->matches(WebKit::toImpl(page)))
+        return false;
+    const auto* item = popup->item(index);
+    if (!item)
+        return false;
+    if (isSelectable)
+        *isSelectable = item->m_type == WebKit::WebPopupItem::Type::Item && item->m_isEnabled && !item->m_isLabel;
+    if (label && labelBytes) {
+        auto utf8 = item->m_text.utf8();
+        const size_t used = std::min(labelBytes - 1, static_cast<size_t>(utf8.length()));
+        memcpy(label, utf8.data(), used);
+        label[used] = '\0';
+    }
+    return true;
+}
+
+extern "C" void WKPagePopupMenuActivatePlayStation(WKPageRef page, int index)
+{
+    auto* popup = WebKit::activePlayStationPopup;
+    if (page && popup && popup->matches(WebKit::toImpl(page)))
+        popup->activate(index);
+}
+
+extern "C" void WKPagePopupMenuCancelPlayStation(WKPageRef page)
+{
+    auto* popup = WebKit::activePlayStationPopup;
+    if (page && popup && popup->matches(WebKit::toImpl(page)))
+        popup->cancel();
+}
